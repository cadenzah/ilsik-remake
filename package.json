{
  "name": "eclipse-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:force": "node scripts/setup.mjs --force",
    "assets": ".venv/bin/python tools/export_web.py data",
    "dev": "vite",
    "start": "node scripts/start.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --dry",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "es-hangul": "^2.4.0"
  }
}
